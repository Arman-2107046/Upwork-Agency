# Public URL of the deployed site, no trailing slash. Used for canonical URLs, Open Graph,
# JSON-LD, robots.txt and sitemap.xml. TODO: replace with the real domain before deploying.
VITE_SITE_URL=https://www.example.com

# Address shown on the contact page and footer, and used for the mailto fallback.
VITE_CONTACT_EMAIL=hello@example.com

# Full URL of the agency's Upwork profile.
VITE_UPWORK_URL=https://www.upwork.com/agencies/your-agency-id

# Form backend that accepts a JSON POST (Formspree: https://formspree.io/f/<id>,
# Web3Forms: https://api.web3forms.com/submit).
VITE_FORM_ENDPOINT=

# Optional: Web3Forms access key. Leave empty for Formspree.
VITE_FORM_ACCESS_KEY=
