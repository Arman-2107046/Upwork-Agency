# Variables for a local run (copy to .env, then use docker-compose.local.yml). On Coolify you
# do not need APP_URL, APP_KEY or DB_PASSWORD: Coolify generates the secrets and takes the URL
# from the domain. Set optional values (admin, email) in its Environment Variables
# tab. See README.md.

# Public URL of the site, no trailing slash. Used for canonical URLs, Open Graph, JSON-LD,
# robots.txt and sitemap.xml. TODO: replace with the real domain before deploying.
APP_URL=http://localhost:8080

# Local runs only (docker-compose.local.yml): host port of the site.
APP_PORT=8080

# Encryption key. Generate one with:  echo "base64:$(openssl rand -base64 32)"
APP_KEY=

# PostgreSQL password (the database runs in the "db" service).
DB_PASSWORD=change-me

# First admin user, created on the first start only. Sign in at /admin, then change the password.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-too

# Contact form email notifications (optional). With MAIL_MAILER=log, messages are only kept in
# the admin inbox. For SMTP: MAIL_MAILER=smtp plus the MAIL_* values from your provider.
MAIL_MAILER=log
# MAIL_HOST=smtp.example.com
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM_ADDRESS=hello@example.com
# Fallback recipient when no notification email is set in the admin (Settings > Site settings).
# CONTACT_NOTIFY_EMAIL=

# Frontend dev server only (npm run dev): where /api and /storage are proxied.
VITE_BACKEND_URL=http://localhost:8080
